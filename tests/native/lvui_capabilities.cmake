cmake_minimum_required(VERSION 3.31)
include("${MODULE}")
set(LVUI_AOT_FRAMEWORKS iiGUI)
lvrs_lvui_legacy_aot_available(_available)
if(_available)
    message(FATAL_ERROR "Independent LVUI must skip legacy LVRS AOT fixtures")
endif()
set(LVUI_AOT_FRAMEWORKS iiGUI LVRS)
lvrs_lvui_legacy_aot_available(_available)
if(NOT _available)
    message(FATAL_ERROR "An explicitly supported legacy framework must remain available")
endif()
unset(LVUI_AOT_FRAMEWORKS)
lvrs_lvui_legacy_aot_available(_available)
if(NOT _available)
    message(FATAL_ERROR "Pre-capability LVUI packages must keep their prior behavior")
endif()
