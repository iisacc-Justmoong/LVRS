function(_lvrs_bootstrap_ndk_supports_cpp23 directory out_var)
    file(GLOB _lvrs_stop_headers
        "${directory}/toolchains/llvm/prebuilt/*/sysroot/usr/include/c++/v1/stop_token")
    file(GLOB _lvrs_expected_headers
        "${directory}/toolchains/llvm/prebuilt/*/sysroot/usr/include/c++/v1/expected")
    if(_lvrs_stop_headers AND _lvrs_expected_headers)
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(_lvrs_bootstrap_detect_android_ndk sdk_root out_var)
    if(DEFINED LVRS_BOOTSTRAP_ANDROID_NDK AND NOT LVRS_BOOTSTRAP_ANDROID_NDK STREQUAL "")
        _lvrs_bootstrap_ndk_supports_cpp23("${LVRS_BOOTSTRAP_ANDROID_NDK}" _lvrs_supported)
        if(NOT _lvrs_supported)
            message(FATAL_ERROR "The explicit LVRS_BOOTSTRAP_ANDROID_NDK needs libc++ <stop_token> and <expected>: ${LVRS_BOOTSTRAP_ANDROID_NDK}")
        endif()
        set(${out_var} "${LVRS_BOOTSTRAP_ANDROID_NDK}" PARENT_SCOPE)
        return()
    endif()
    set(_lvrs_candidates "$ENV{CMAKE_ANDROID_NDK}" "$ENV{ANDROID_NDK_ROOT}" "$ENV{ANDROID_NDK_HOME}"
        /opt/homebrew/share/android-ndk /usr/local/share/android-ndk)
    if(IS_DIRECTORY "${sdk_root}/ndk")
        file(GLOB _lvrs_sdk_candidates LIST_DIRECTORIES TRUE "${sdk_root}/ndk/*")
        list(SORT _lvrs_sdk_candidates COMPARE NATURAL ORDER DESCENDING)
        list(APPEND _lvrs_candidates ${_lvrs_sdk_candidates})
    endif()
    foreach(_lvrs_candidate IN LISTS _lvrs_candidates)
        if(_lvrs_candidate STREQUAL "" OR NOT IS_DIRECTORY "${_lvrs_candidate}")
            continue()
        endif()
        _lvrs_bootstrap_ndk_supports_cpp23("${_lvrs_candidate}" _lvrs_supported)
        if(_lvrs_supported)
            message(STATUS "LVRS framework bootstrap: C++23 Android NDK -> ${_lvrs_candidate}")
            set(${out_var} "${_lvrs_candidate}" PARENT_SCOPE)
            return()
        endif()
        message(STATUS "LVRS framework bootstrap: ignoring ambient NDK without C++23 library headers: ${_lvrs_candidate}")
    endforeach()
    message(FATAL_ERROR "A C++23 Android NDK with libc++ <stop_token> and <expected> is required; set LVRS_BOOTSTRAP_ANDROID_NDK.")
endfunction()
