@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiGUI 0.4 CONFIG)
get_target_property(_lvrs_gui_abi iiGUI::iiGUI IIGUI_NATIVE_ABI_ID)
if(NOT _lvrs_gui_abi)
    set(_lvrs_gui_abi "${iiGUI_NATIVE_ABI_ID}")
endif()
if(NOT _lvrs_gui_abi STREQUAL "@LVRS_IIGUI_ABI_ID@")
    message(FATAL_ERROR "LVRS/iiGUI native ABI mismatch. Rebuild LVRS with the selected iiGUI kit.")
endif()
find_dependency(iiSDKCore 0.18.1 CONFIG)
find_dependency(iiFileProviderNative 0.9 CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../iiFileProviderNative")
include("${CMAKE_CURRENT_LIST_DIR}/LVRSTargets.cmake")
set(LVRS_NATIVE TRUE)
set(LVRS_Native_FOUND TRUE)
set(LVRS_NATIVE_RESOURCES ${iiGUI_NATIVE_RESOURCES})
check_required_components(LVRS)
