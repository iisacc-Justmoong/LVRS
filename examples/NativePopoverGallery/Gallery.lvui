import vm NativePopoverBackend
ApplicationWindow(title: "LVRS Native Popover", width: 800, height: 700, minimumWidth: 640, minimumHeight: 600, accent: .purple) {
    VStack(spacing: 12, padding: 20) {
        Label(text: "LVRS Popover · native C++ content", style: .header)
        Label(text: "Edit a shared color, apply, cancel or click outside", style: .body)
        ColorPickerButton(id: "open", model: vm.model, buttonSize: .Large, accessibilityName: "Edit color", onClick: vm.open)
        LabelButton(id: "outside", text: "Outside action", tone: .default, onClick: vm.outside)
        Label(id: "color", text: "Current color", style: .body)
        Label(id: "status", text: "Popover is closed", style: .caption)
        Label(id: "worker", text: "Background result pending", style: .caption)
        Label(id: "frames", text: "Core display frames: 0", style: .caption)
        LabelButton(id: "close", text: "Close", onClick: vm.close)
        Popover(id: "editor", accessibilityName: "Color editor popover", onOpened: vm.opened, onClosed: vm.closed) {
            ColorPicker(id: "picker", model: vm.model, type: .Wheel, onAccepted: vm.accepted, onCanceled: vm.canceled)
        }
    }
}
