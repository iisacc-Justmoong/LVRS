    {
      "id": "b000007",
      "kind": "heading",
      "start_line": 18,
      "end_line": 18,
      "raw": "## 보존한 AGENTS.md 프로젝트 지침\n",
      "level": 2,
      "title": "보존한 AGENTS.md 프로젝트 지침"
    },
    {
      "id": "b000008",
      "kind": "blank",
