      "kind": "list",
      "start_line": 13,
      "end_line": 14,
      "raw": "- `lvrs::preApplicationBootstrap(options)`\n- `lvrs::postApplicationBootstrap(app, options)`\n",
      "items": [
        {
          "marker": "-",
          "text": "`lvrs::preApplicationBootstrap(options)`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`lvrs::postApplicationBootstrap(app, options)`",
