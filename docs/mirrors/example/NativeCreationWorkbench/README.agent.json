  "blocks": [
    {
      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# Native Creation Workbench\n",
      "level": 1,
      "title": "Native Creation Workbench"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 6,
      "raw": "A Qt-free LVUI/iiGUI authoring probe for a creation workspace: native parameter\ncontrols, C++ canvas and timeline sources, captured pointer input, asynchronous\nprocedural RGBA generation, keyed result rows, selection and retained frame playback.\nIt demonstrates SDK view capabilities; it does not migrate Dreamscapes or run an AI model.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 7,
      "end_line": 7,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 8,
      "end_line": 11,
      "raw": "Build with CMake in `build/`, using installed native LVRS/LVUI/iiGUI packages.\nRun normally for interactive use, or use `--self-test` during the final verification batch.\nThe self-test verifies GPU frame pixels, view-only pan/seek, result selection,\nresponsive layout, retained input, display-frame callbacks and backend retirement.\n"
    },
    {
      "id": "b000006",
      "kind": "blank",
      "start_line": 12,
      "end_line": 12,
      "raw": "\n"
    },
    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 13,
      "end_line": 13,
      "raw": "See [the behavior contract](docs/Behavior.md) and [the usage example](example/README.md).\n"
    }
  ],
