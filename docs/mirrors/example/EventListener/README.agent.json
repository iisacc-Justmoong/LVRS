      "id": "b000071",
      "kind": "fenced_code",
      "start_line": 154,
      "end_line": 166,
      "raw": "```qml\nfunction onAction(tag) {\n    console.log(\"action:\", tag)\n}\n\nLV.Label {\n    text: \"Reusable\"\n    LV.EventListener {\n        trigger: \"clicked\"\n        action: () => onAction(\"label\")\n    }\n}\n```\n",
      "language": "qml",
      "code": "function onAction(tag) {\n    console.log(\"action:\", tag)\n}\n\nLV.Label {\n    text: \"Reusable\"\n    LV.EventListener {\n        trigger: \"clicked\"\n        action: () => onAction(\"label\")\n    }\n}\n",
      "closed": true
