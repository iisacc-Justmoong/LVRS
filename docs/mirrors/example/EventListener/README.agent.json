      "end_line": 56,
      "raw": "```qml\nRectangle {\n    width: 120; height: 40; color: \"#333\"\n    LV.EventListener {\n        trigger: \"hoverChanged\"\n        action: (e) => console.log(\"hover:\", e.containsMouse)\n    }\n}\n```\n",
      "language": "qml",
      "code": "Rectangle {\n    width: 120; height: 40; color: \"#333\"\n    LV.EventListener {\n        trigger: \"hoverChanged\"\n        action: (e) => console.log(\"hover:\", e.containsMouse)\n    }\n}\n",
      "closed": true
    },
