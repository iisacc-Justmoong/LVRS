      "kind": "fenced_code",
      "start_line": 110,
      "end_line": 123,
      "raw": "```qml\nTextInput {\n    id: input\n    focus: true\n\n    LV.EventListener {\n        trigger: \"keyPressed\"\n        action: (event) => {\n            if (event.key === Qt.Key_Return)\n                console.log(\"enter\")\n        }\n    }\n}\n```\n",
      "language": "qml",
      "code": "TextInput {\n    id: input\n    focus: true\n\n    LV.EventListener {\n        trigger: \"keyPressed\"\n        action: (event) => {\n            if (event.key === Qt.Key_Return)\n                console.log(\"enter\")\n        }\n    }\n}\n",
      "closed": true
