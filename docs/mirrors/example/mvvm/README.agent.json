    {
      "id": "b000021",
      "kind": "heading",
      "start_line": 27,
      "end_line": 27,
      "raw": "## Plain-language explanation (non-developers)\n",
      "level": 2,
      "title": "Plain-language explanation (non-developers)"
    },
    {
      "id": "b000022",
      "kind": "blank",
      "start_line": 28,
      "end_line": 28,
      "raw": "\n"
    },
    {
      "id": "b000023",
      "kind": "paragraph",
      "start_line": 29,
      "end_line": 29,
      "raw": "Think of the app like a restaurant:\n"
    },
    {
      "id": "b000024",
      "kind": "list",
      "start_line": 30,
      "end_line": 33,
      "raw": "- **Model** is the kitchen (where the real data lives).\n- **ViewModel** is the waiter (it knows how to ask the kitchen and deliver answers).\n- **View (QML)** is the menu/table (what the user actually sees and clicks).\n- **ViewModels registry** is the host stand (it helps the table find the right waiter).\n",
      "items": [
        {
          "marker": "-",
          "text": "**Model** is the kitchen (where the real data lives).",
          "checked": null
        },
        {
          "marker": "-",
          "text": "**ViewModel** is the waiter (it knows how to ask the kitchen and deliver answers).",
          "checked": null
        },
        {
          "marker": "-",
          "text": "**View (QML)** is the menu/table (what the user actually sees and clicks).",
          "checked": null
        },
        {
          "marker": "-",
          "text": "**ViewModels registry** is the host stand (it helps the table find the right waiter).",
          "checked": null
        }
      ]
    },
    {
      "id": "b000025",
      "kind": "blank",
      "start_line": 34,
      "end_line": 34,
      "raw": "\n"
    },
    {
      "id": "b000026",
      "kind": "paragraph",
      "start_line": 35,
      "end_line": 36,
      "raw": "This example shows how data flows from the kitchen → waiter → table without the table\nneeding to walk into the kitchen.\n"
    },
    {
      "id": "b000027",
      "kind": "blank",
      "start_line": 37,
      "end_line": 37,
      "raw": "\n"
    },
