      "raw": "\n"
    },
    {
      "id": "b000009",
      "kind": "paragraph",
      "start_line": 21,
      "end_line": 23,
      "raw": "The Windows export and QML-only link regressions pass. The failing full suite\nprevents this maintenance run from installing the framework. No checks are\ndisabled. Run all tests with `ctest --test-dir build --output-on-failure`.\n"
    }
