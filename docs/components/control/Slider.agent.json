      "kind": "html",
      "start_line": 73,
      "end_line": 73,
      "raw": "<a id=\"labels-icons-and-appearance\"></a>\n"
    },
    {
      "id": "b000036",
      "kind": "blank",
      "start_line": 74,
      "end_line": 74,
      "raw": "\n"
    },
    {
      "id": "b000037",
      "kind": "heading",
      "start_line": 75,
      "end_line": 75,
      "raw": "## 레이블, 아이콘 및 모양\n",
      "level": 2,
      "title": "레이블, 아이콘 및 모양"
    },
    {
      "id": "b000038",
      "kind": "blank",
