      "id": "b000037",
      "kind": "fenced_code",
      "start_line": 67,
      "end_line": 76,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.ComboBox {\n    text: \"Control\"\n    tone: LV.ComboBox.Borderless\n    arrow: LV.Stepper.Down\n    method: function(eventData) { menu.open() }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.ComboBox {\n    text: \"Control\"\n    tone: LV.ComboBox.Borderless\n    arrow: LV.Stepper.Down\n    method: function(eventData) { menu.open() }\n}\n",
      "closed": true
