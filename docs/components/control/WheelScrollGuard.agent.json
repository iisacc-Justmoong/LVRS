      "end_line": 55,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.WheelScrollGuard {\n    targetFlickable: editorFlick\n    consumeInside: false\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.WheelScrollGuard {\n    targetFlickable: editorFlick\n    consumeInside: false\n}\n",
      "closed": true
