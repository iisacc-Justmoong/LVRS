    {
      "id": "b000029",
      "kind": "fenced_code",
      "start_line": 37,
      "end_line": 44,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.InputMethodGuard {\n    target: editor\n    guardEnabled: enabled && !readOnly\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.InputMethodGuard {\n    target: editor\n    guardEnabled: enabled && !readOnly\n}\n",
      "closed": true
    },
