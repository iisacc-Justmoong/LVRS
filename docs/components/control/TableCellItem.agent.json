      "start_line": 103,
      "end_line": 103,
      "raw": "\n"
    },
    {
      "id": "b000053",
      "kind": "fenced_code",
      "start_line": 104,
      "end_line": 117,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.TableCellItem {\n    valueType: \"int\"\n    valueValidator: function(value) {\n        const text = String(value).trim()\n        if (!/^-?\\d+$/.test(text))\n            return { accepted: false, text: text, value: value }\n        const intValue = Number(text)\n        return { accepted: true, text: String(intValue), value: intValue }\n    }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.TableCellItem {\n    valueType: \"int\"\n    valueValidator: function(value) {\n        const text = String(value).trim()\n        if (!/^-?\\d+$/.test(text))\n            return { accepted: false, text: text, value: value }\n        const intValue = Number(text)\n        return { accepted: true, text: String(intValue), value: intValue }\n    }\n}\n",
      "closed": true
    },
