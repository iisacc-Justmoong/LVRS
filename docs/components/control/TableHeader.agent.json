      "id": "b000033",
      "kind": "fenced_code",
      "start_line": 56,
      "end_line": 67,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.TableHeader {\n    columnWidths: [160, 80, 120]\n    cellItems: [\n        { label: \"Name\", type: \"string\" },\n        { label: \"Count\", type: \"int\", leadingIcon: \"\", trailingIcon: \"generalchevronDown\" },\n        { label: \"Enabled\", type: \"bool\" }\n    ]\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.TableHeader {\n    columnWidths: [160, 80, 120]\n    cellItems: [\n        { label: \"Name\", type: \"string\" },\n        { label: \"Count\", type: \"int\", leadingIcon: \"\", trailingIcon: \"generalchevronDown\" },\n        { label: \"Enabled\", type: \"bool\" }\n    ]\n}\n",
