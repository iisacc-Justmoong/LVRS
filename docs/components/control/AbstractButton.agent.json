    {
      "id": "b000055",
      "kind": "fenced_code",
      "start_line": 83,
      "end_line": 96,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.AbstractButton {\n    text: \"Action\"\n    tone: LV.AbstractButton.Primary\n    method: function(eventData) {\n        saveModel(eventData.source)\n    }\n    methods: [\n        function(eventData) { audit(\"clicked\", eventData.trigger) }\n    ]\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.AbstractButton {\n    text: \"Action\"\n    tone: LV.AbstractButton.Primary\n    method: function(eventData) {\n        saveModel(eventData.source)\n    }\n    methods: [\n        function(eventData) { audit(\"clicked\", eventData.trigger) }\n    ]\n}\n",
      "closed": true
    },
