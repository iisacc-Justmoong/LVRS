      "id": "b000041",
      "kind": "fenced_code",
      "start_line": 68,
      "end_line": 81,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.PageTransitionController {\n    id: transitions\n    router: router\n\n    function driveBackSwipe(progress, velocityX) {\n        if (!active)\n            beginBack({ source: \"edge-pan\" })\n        update(progress, { velocityX: velocityX })\n    }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.PageTransitionController {\n    id: transitions\n    router: router\n\n    function driveBackSwipe(progress, velocityX) {\n        if (!active)\n            beginBack({ source: \"edge-pan\" })\n        update(progress, { velocityX: velocityX })\n    }\n}\n",
      "closed": true
    },
