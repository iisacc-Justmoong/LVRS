      "id": "b000069",
      "kind": "heading",
      "start_line": 115,
      "end_line": 115,
      "raw": "## 사용법\n",
      "level": 2,
      "title": "사용법"
    },
    {
      "id": "b000070",
      "kind": "blank",
      "start_line": 116,
      "end_line": 116,
      "raw": "\n"
    },
    {
      "id": "b000071",
      "kind": "fenced_code",
      "start_line": 117,
      "end_line": 142,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.HierarchyToolbar {\n    id: toolbar\n    buttonItems: [\n        {\n            id: \"structure\",\n            iconName: \"projectStructure\",\n            selected: true,\n            eventName: \"hierarchy.structure\"\n        },\n        {\n            id: \"layers\",\n            iconName: \"projectStructure\",\n            events: [\n                \"hierarchy.layers\",\n                { name: \"analytics.hierarchy.layers\", payload: ({ source: \"toolbar\" }) }\n            ],\n            onClicked: function(ctx) {\n                ctx.emit(\"hierarchy.layers.clicked\", ({ id: ctx.buttonId }))\n            }\n        }\n    ]\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.HierarchyToolbar {\n    id: toolbar\n    buttonItems: [\n        {\n            id: \"structure\",\n            iconName: \"projectStructure\",\n            selected: true,\n            eventName: \"hierarchy.structure\"\n        },\n        {\n            id: \"layers\",\n            iconName: \"projectStructure\",\n            events: [\n                \"hierarchy.layers\",\n                { name: \"analytics.hierarchy.layers\", payload: ({ source: \"toolbar\" }) }\n            ],\n            onClicked: function(ctx) {\n                ctx.emit(\"hierarchy.layers.clicked\", ({ id: ctx.buttonId }))\n            }\n        }\n    ]\n}\n",
      "closed": true
    },
