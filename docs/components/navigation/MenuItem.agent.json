        {
          "marker": "-",
          "text": "`keyVisible`가 `false`이면 키 텍스트가 숨겨집니다.",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`keyVisible`가 `true`이고 `key`가 비어 있으면 `keyPlaceholder`가 렌더링됩니다.",
          "checked": null
        },
        {
          "marker": "-",
          "text": "쉐브론은 `effectiveShowChevron`가 `true`인 경우에만 표시됩니다.",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`selectionDirection: \"auto\"`는 `expanded=false`를 오른쪽으로, `expanded=true`를 아래쪽으로 매핑합니다.",
          "checked": null
        }
      ]
    },
