      "kind": "heading",
      "start_line": 75,
      "end_line": 75,
      "raw": "## 사용법\n",
      "level": 2,
      "title": "사용법"
    },
    {
      "id": "b000042",
      "kind": "blank",
      "start_line": 76,
      "end_line": 76,
      "raw": "\n"
    },
    {
      "id": "b000043",
      "kind": "fenced_code",
      "start_line": 77,
      "end_line": 91,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.MenuItem {\n    label: \"Open Recent\"\n    showIconSlot: false\n    key: \"Cmd+O\"\n    keyVisible: true\n    hasChildItems: true\n    showChevron: true\n    expanded: false\n    selectionDirection: \"auto\"\n    state: selectedState\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.MenuItem {\n    label: \"Open Recent\"\n    showIconSlot: false\n    key: \"Cmd+O\"\n    keyVisible: true\n    hasChildItems: true\n    showChevron: true\n    expanded: false\n    selectionDirection: \"auto\"\n    state: selectedState\n}\n",
      "closed": true
