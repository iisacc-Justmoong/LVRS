      "raw": "## 사용법\n",
      "level": 2,
      "title": "사용법"
    },
    {
      "id": "b000076",
      "kind": "blank",
      "start_line": 132,
      "end_line": 132,
      "raw": "\n"
    },
    {
      "id": "b000077",
      "kind": "fenced_code",
      "start_line": 133,
      "end_line": 145,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.ContextMenu {\n    id: menu\n    showIconSlot: false\n    items: [\n        { label: \"Copy\", eventName: \"menu.copy\", showChevron: false },\n        { type: \"divider\" },\n        { label: \"Inspect\", showIconSlot: true, keepOpen: true, events: [\"menu.inspect\"] }\n    ]\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.ContextMenu {\n    id: menu\n    showIconSlot: false\n    items: [\n        { label: \"Copy\", eventName: \"menu.copy\", showChevron: false },\n        { type: \"divider\" },\n        { label: \"Inspect\", showIconSlot: true, keepOpen: true, events: [\"menu.inspect\"] }\n    ]\n}\n",
      "closed": true
    },
    {
      "id": "b000078",
      "kind": "blank",
      "start_line": 146,
      "end_line": 146,
      "raw": "\n"
    },
    {
      "id": "b000079",
      "kind": "fenced_code",
      "start_line": 147,
      "end_line": 163,
      "raw": "```qml\nComponent {\n    id: destructiveMenuRow\n\n    LV.MenuItem {\n        property var modelData: ({})\n        label: modelData.label || \"\"\n        enabled: modelData.enabled === true\n        onClicked: modelData.trigger()\n    }\n}\n\nLV.ContextMenu {\n    itemDelegate: destructiveMenuRow\n    items: [{ label: \"Delete\", eventName: \"delete\" }]\n}\n```\n",
      "language": "qml",
      "code": "Component {\n    id: destructiveMenuRow\n\n    LV.MenuItem {\n        property var modelData: ({})\n        label: modelData.label || \"\"\n        enabled: modelData.enabled === true\n        onClicked: modelData.trigger()\n    }\n}\n\nLV.ContextMenu {\n    itemDelegate: destructiveMenuRow\n    items: [{ label: \"Delete\", eventName: \"delete\" }]\n}\n",
      "closed": true
    },
