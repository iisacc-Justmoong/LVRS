      "start_line": 130,
      "end_line": 130,
      "raw": "\n"
    },
    {
      "id": "b000065",
      "kind": "fenced_code",
      "start_line": 131,
      "end_line": 142,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.PageRouter {\n    id: router\n    routes: [\n        { path: \"/\", component: homePage },\n        { path: \"/runs/[id]\", component: runPage }\n    ]\n    initialPath: \"/\"\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.PageRouter {\n    id: router\n    routes: [\n        { path: \"/\", component: homePage },\n        { path: \"/runs/[id]\", component: runPage }\n    ]\n    initialPath: \"/\"\n}\n",
      "closed": true
    },
    {
