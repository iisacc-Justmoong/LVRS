    {
      "id": "b000021",
      "kind": "fenced_code",
      "start_line": 30,
      "end_line": 55,
      "raw": "```qml\nimport QtQuick\nimport LVRS 1.0 as LV\n\nLV.ApplicationWindow {\n    id: root\n    visible: true\n\n    LV.WindowSafeAreaObserver {\n        id: safeArea\n        window: root\n    }\n\n    Rectangle {\n        anchors.fill: parent\n        color: \"#111827\"\n    }\n\n    Item {\n        x: safeArea.leftInset\n        y: safeArea.topInset\n        width: parent.width - safeArea.leftInset - safeArea.rightInset\n        height: 56\n    }\n}\n```\n",
      "language": "qml",
      "code": "import QtQuick\nimport LVRS 1.0 as LV\n\nLV.ApplicationWindow {\n    id: root\n    visible: true\n\n    LV.WindowSafeAreaObserver {\n        id: safeArea\n        window: root\n    }\n\n    Rectangle {\n        anchors.fill: parent\n        color: \"#111827\"\n    }\n\n    Item {\n        x: safeArea.leftInset\n        y: safeArea.topInset\n        width: parent.width - safeArea.leftInset - safeArea.rightInset\n        height: 56\n    }\n}\n",
      "closed": true
    },
