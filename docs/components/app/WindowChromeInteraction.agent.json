    {
      "id": "b000021",
      "kind": "fenced_code",
      "start_line": 35,
      "end_line": 55,
      "raw": "```qml\nimport QtQuick\nimport QtQuick.Controls\nimport LVRS as LV\n\nApplicationWindow {\n    id: root\n    visible: true\n\n    LV.WindowChromeInteraction {\n        anchors.fill: parent\n        targetWindow: root\n        moveExclusionItems: [menuButton]\n    }\n\n    Button {\n        id: menuButton\n        text: \"Menu\"\n    }\n}\n```\n",
      "language": "qml",
      "code": "import QtQuick\nimport QtQuick.Controls\nimport LVRS as LV\n\nApplicationWindow {\n    id: root\n    visible: true\n\n    LV.WindowChromeInteraction {\n        anchors.fill: parent\n        targetWindow: root\n        moveExclusionItems: [menuButton]\n    }\n\n    Button {\n        id: menuButton\n        text: \"Menu\"\n    }\n}\n",
      "closed": true
    }
