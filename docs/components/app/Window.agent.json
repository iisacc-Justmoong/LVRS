        },
        {
          "marker": "-",
          "text": "`requestWindowMove()`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`requestWindowResize(edges)`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`windowMoveAttempted(started)`",
          "checked": null
        },
        {
