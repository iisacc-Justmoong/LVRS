      "id": "b000023",
      "kind": "fenced_code",
      "start_line": 26,
      "end_line": 34,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.HStack {\n    LV.Label { text: \"Left\" }\n    LV.Spacer {}\n    LV.Label { text: \"Right\" }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.HStack {\n    LV.Label { text: \"Left\" }\n    LV.Spacer {}\n    LV.Label { text: \"Right\" }\n}\n",
