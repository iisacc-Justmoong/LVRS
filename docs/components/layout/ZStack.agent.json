      "id": "b000026",
      "kind": "blank",
      "start_line": 31,
      "end_line": 31,
      "raw": "\n"
    },
    {
      "id": "b000027",
      "kind": "fenced_code",
      "start_line": 32,
      "end_line": 40,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.ZStack {\n    alignmentName: \"topTrailing\"\n    Rectangle { anchors.fill: parent }\n    Rectangle { width: 14; height: 14; radius: 7 }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.ZStack {\n    alignmentName: \"topTrailing\"\n    Rectangle { anchors.fill: parent }\n    Rectangle { width: 14; height: 14; radius: 7 }\n}\n",
      "closed": true
    },
