      "id": "b000023",
      "kind": "fenced_code",
      "start_line": 28,
      "end_line": 37,
      "raw": "```qml\nimport LVRS 1.0 as LV\n\nLV.HStack {\n    alignmentName: \"bottom\"\n    spacing: 12\n    LV.LabelButton { text: \"Cancel\" }\n    LV.LabelButton { text: \"Save\"; tone: LV.AbstractButton.Primary }\n}\n```\n",
      "language": "qml",
      "code": "import LVRS 1.0 as LV\n\nLV.HStack {\n    alignmentName: \"bottom\"\n    spacing: 12\n    LV.LabelButton { text: \"Cancel\" }\n    LV.LabelButton { text: \"Save\"; tone: LV.AbstractButton.Primary }\n}\n",
      "closed": true
