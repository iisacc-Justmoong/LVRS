      "end_line": 8,
      "raw": "\n"
    },
    {
      "id": "b000009",
      "kind": "heading",
      "start_line": 9,
      "end_line": 9,
      "raw": "## 목적\n",
      "level": 2,
      "title": "목적"
    },
