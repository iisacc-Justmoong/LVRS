    {
      "id": "b000049",
      "kind": "paragraph",
      "start_line": 95,
      "end_line": 95,
      "raw": "사용자 정의 싱글턴 예:\n"
    },
    {
      "id": "b000050",
      "kind": "blank",
      "start_line": 96,
      "end_line": 96,
      "raw": "\n"
    },
    {
      "id": "b000051",
      "kind": "fenced_code",
      "start_line": 97,
      "end_line": 115,
      "raw": "```cpp\nauto singletonRegistration = lvrs::qmlCustomTypeRegistration(\n    QStringLiteral(\"WhatSon.Internal\"),\n    1,\n    0,\n    QStringLiteral(\"WorkspaceServices\"),\n    lvrs::QmlTypeRegistrationKind::Singleton,\n    []() {\n        return qmlRegisterSingletonType<WorkspaceServices>(\n            \"WhatSon.Internal\",\n            1,\n            0,\n            \"WorkspaceServices\",\n            [](QQmlEngine *, QJSEngine *) -> QObject * {\n                return WorkspaceServices::instance();\n            });\n    },\n    QStringLiteral(\"WorkspaceServices\"));\n```\n",
      "language": "cpp",
      "code": "auto singletonRegistration = lvrs::qmlCustomTypeRegistration(\n    QStringLiteral(\"WhatSon.Internal\"),\n    1,\n    0,\n    QStringLiteral(\"WorkspaceServices\"),\n    lvrs::QmlTypeRegistrationKind::Singleton,\n    []() {\n        return qmlRegisterSingletonType<WorkspaceServices>(\n            \"WhatSon.Internal\",\n            1,\n            0,\n            \"WorkspaceServices\",\n            [](QQmlEngine *, QJSEngine *) -> QObject * {\n                return WorkspaceServices::instance();\n            });\n    },\n    QStringLiteral(\"WorkspaceServices\"));\n",
      "closed": true
    },
