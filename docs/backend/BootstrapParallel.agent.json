    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "위치: `src/backend/runtime/bootstrapparallel.h` / `src/backend/runtime/bootstrapparallel.cpp`\n"
