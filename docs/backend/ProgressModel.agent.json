    {
      "id": "b000029",
      "kind": "heading",
      "start_line": 53,
      "end_line": 53,
      "raw": "## 동작 원리\n",
      "level": 2,
      "title": "동작 원리"
    },
    {
      "id": "b000030",
      "kind": "blank",
