      "kind": "fenced_code",
      "start_line": 52,
      "end_line": 54,
      "raw": "```cpp\nViewModels.bindView(viewId, key, writable)\n```\n",
      "language": "cpp",
      "code": "ViewModels.bindView(viewId, key, writable)\n",
      "closed": true
    },
    {
