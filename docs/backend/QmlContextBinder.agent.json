    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "위치: `src/backend/runtime/qmlcontextbinder.h` / `src/backend/runtime/qmlcontextbinder.cpp`\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
