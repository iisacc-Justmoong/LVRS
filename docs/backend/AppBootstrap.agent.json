      "raw": "\n"
    },
    {
      "id": "b000105",
      "kind": "heading",
      "start_line": 175,
      "end_line": 175,
      "raw": "## `postApplicationBootstrap`의 기능\n",
      "level": 2,
      "title": "`postApplicationBootstrap`의 기능"
    },
